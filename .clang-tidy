# Every check of clang-tidy 21, minus the exclusions below, each with its reason. The CI pins the
# version, so a new check only appears with a deliberate version bump.
FormatStyle: file
WarningsAsErrors: "false"
HeaderFileExtensions: ["hpp"]
ImplementationFileExtensions: ["cpp"]
# Report the findings in the headers of this repository too, not only in the analyzed sources
HeaderFilterRegex: ".*"
Checks:
  - "*"
  # Families written for other projects or platforms
  - -abseil-*
  - -altera-*
  - -android-*
  - -fuchsia-*
  - -zircon-*
  # LLVM's own style: include guards where #pragma once is used, the rules of its libc, and a
  # preference for static over anonymous namespaces that misc-use-anonymous-namespace contradicts.
  # The include order is kept.
  - -llvm-*
  - -llvmlibc-*
  - llvm-include-order
  # Google's style is kept, except the long of the system APIs and the TODO(user) convention
  - -google-runtime-int
  - -google-readability-todo
  # Style choices
  - -modernize-use-trailing-return-type
  - -portability-avoid-pragma-once
  - -readability-identifier-length
  - -readability-redundant-access-specifiers
  - -cppcoreguidelines-avoid-do-while
  - -clang-diagnostic-unused-const-variable
  # Checks that need the GSL
  - -cppcoreguidelines-owning-memory
  - -cppcoreguidelines-pro-bounds-array-to-pointer-decay
  - -cppcoreguidelines-pro-bounds-constant-array-index
  - -hicpp-no-array-decay
  # Services are injected by reference and held as such
  - -cppcoreguidelines-avoid-const-or-ref-data-members
  # The underlying type of an enum is part of the ABI
  - -performance-enum-size
  # Noisy on register and bit-field code
  - -hicpp-signed-bitwise
  # The remedy, a strong type per parameter, is out of proportion
  - -bugprone-easily-swappable-parameters
  # Enums are scoped with the `struct X { enum Enum }` idiom, and C headers keep their macros
  - -cppcoreguidelines-use-enum-class
  - -cppcoreguidelines-macro-to-enum
  - -modernize-macro-to-enum
  # Boost.Range is not used; modernize-use-ranges covers the standard ranges
  - -boost-use-ranges
  # Data structs with helpers, and static functions in headers shared with C
  - -cppcoreguidelines-non-private-member-variables-in-classes
  - -misc-non-private-member-variables-in-classes
  - -misc-use-anonymous-namespace
  - -misc-use-internal-linkage
  # Alias of cppcoreguidelines-special-member-functions, whose options would not apply to it
  - -hicpp-special-member-functions
CheckOptions: {
        # cppcoreguidelines-special-member-functions: a class that declares a destructor, a copy or
        # a move declares the five or deletes them, except an interface with a sole defaulted
        # destructor, a class whose copy or move is deleted by a member, and a non-copyable class
        # that declares no move
        cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true,
        cppcoreguidelines-special-member-functions.AllowImplicitlyDeletedCopyOrMove: true,
        cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true,
        # readability-identifier-naming for naming convention
        readability-identifier-naming.AbstractClassPrefix: "A",
        readability-identifier-naming.ClassCase: "CamelCase",
        readability-identifier-naming.ClassConstantCase: "UPPER_CASE",
        readability-identifier-naming.ClassMemberCase: "CamelCase",
        readability-identifier-naming.ClassMethodCase: "CamelCase",
        readability-identifier-naming.ConceptCase: "CamelCase",
        readability-identifier-naming.ConstantMemberCase: "camelBack",
        readability-identifier-naming.ConstantMemberPrefix: "m_",
        readability-identifier-naming.EnumCase: "CamelCase",
        readability-identifier-naming.EnumConstantCase: "UPPER_CASE",
        readability-identifier-naming.MemberCase: "camelBack",
        readability-identifier-naming.MethodCase: "camelBack",
        readability-identifier-naming.PrivateMemberPrefix: "m_",
        readability-identifier-naming.ProtectedMemberPrefix: "m_",
        readability-identifier-naming.StaticConstantCase: "UPPER_CASE",
        readability-identifier-naming.StaticVariableCase: "UPPER_CASE",
    }
