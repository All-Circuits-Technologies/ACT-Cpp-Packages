// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "ACT C++ packages",
	// The toolchain image the CI publishes, built from image/Dockerfile: the CI builds it once per
	// Dockerfile change and everyone runs the same one, so nothing is built on your machine. To try
	// a Dockerfile change, build it by hand under this tag and start the container offline, or
	// point this at the hash tag the pull request's "Toolchain image" job printed.
	"image": "ghcr.io/all-circuits-technologies/act-cpp-packages:dev",
	// Refreshed before every start, a no-op when up to date. Offline, the container starts on the
	// image already present. Same image as above.
	"initializeCommand": "docker pull ghcr.io/all-circuits-technologies/act-cpp-packages:dev || true",
	// The image's default user is root, which the CI's container jobs need; work as the
	// unprivileged user it creates.
	"remoteUser": "dev",
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cmake-tools",
				"twxs.cmake",
				"streetsidesoftware.code-spell-checker",
				"DavidAnson.vscode-markdownlint",
				"yzhang.markdown-all-in-one",
				"mhutchie.git-graph",
				"donjayamanne.githistory",
				"eamodio.gitlens",
				"llvm-vs-code-extensions.vscode-clangd",
				"josetr.cmake-language-support-vscode",
				"heltonricardo.heltonricardo-vscode-organize-and-format",
				"KylinIdeTeam.cmake-intellisence",
				"github.vscode-github-actions",
				"ms-azuretools.vscode-containers"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"cmake.configureOnOpen": false,
				"editor.formatOnSave": true,
				"editor.tabSize": 4,
				"files.trimTrailingWhitespace": true,
				"files.insertFinalNewline": true,
				"extensions.verifySignature": false,
				// Clang searches for "clangd" and not "clangd-21" so we need to
				// point it to the correct path
				"clangd.path": "/usr/bin/clangd-21",
				"files.associations": {
					// File associations for clang-tidy and clang-format file
					"*.clang*": "yaml"
				}
			}
		}
	}
}
