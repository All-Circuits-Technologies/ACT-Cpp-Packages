# Same rules as the libraries, except the abstract class prefix: a GoogleTest fixture is abstract
# by construction (testing::Test::TestBody is pure virtual), but it is not an interface and keeps
# the conventional `<Subject>Test` name.
InheritParentConfig: true
CheckOptions: {
        readability-identifier-naming.AbstractClassPrefix: "",
    }
